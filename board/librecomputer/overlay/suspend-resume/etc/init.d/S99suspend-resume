#!/bin/sh

start() {
	sleep 10
	echo mem > /sys/power/state
}
stop() {
	:
}
restart() {
        stop
        start
}

case "$1" in
        start)
                start
                ;;
        stop)
                stop
                ;;
        restart|reload)
                restart
                ;;
        *)
                echo "Usage: $0 {start|stop|restart}"
                exit 1
                ;;
esac

exit $?

